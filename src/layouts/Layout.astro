---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #155799;
    --color-secondary: #159957;
    --color-bg: #ffffff;
    --color-text: #606c71;
    --color-heading: #155799;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Open Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text);
  }

  header {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: white;
    text-align: center;
    padding: 3rem 1rem;
  }

  header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  header p {
    font-size: 1.25rem;
    font-weight: 300;
    opacity: 0.9;
  }

  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  h1, h2, h3, h4, h5, h6 {
    color: var(--color-heading);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  h2 {
    font-size: 1.75rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid #eee;
  }

  h3 {
    font-size: 1.5rem;
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  code {
    background-color: #f3f6fa;
    color: #567482;
    padding: 2px 4px;
    border-radius: 0.3rem;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.9rem;
  }

  pre {
    background-color: #f3f6fa;
    padding: 1rem;
    border-radius: 0.3rem;
    overflow-x: auto;
    margin: 1rem 0;
  }

  pre code {
    background: transparent;
    padding: 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    header h1 {
      font-size: 2rem;
    }

    header p {
      font-size: 1.1rem;
    }
  }
</style>
