---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #3b82f6;
    --color-secondary: #06b6d4;
    --color-bg: #ffffff;
    --color-text: #475569;
    --color-heading: #1e293b;
    --color-light-gray: #f8fafc;
    --color-border: #e2e8f0;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text);
    background: var(--color-bg);
  }

  header {
    background: var(--color-light-gray);
    border-bottom: 1px solid var(--color-border);
    padding: 2rem 1rem;
  }

  header .header-content {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  header .logo {
    height: 60px;
    width: auto;
  }

  header h1 {
    font-size: 2rem;
    margin: 0;
    font-weight: 600;
    color: var(--color-heading);
  }

  header p {
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--color-text);
    margin: 0.25rem 0 0 0;
  }

  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  h1, h2, h3, h4, h5, h6 {
    color: var(--color-heading);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  h2 {
    font-size: 1.875rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
    margin-top: 3rem;
  }

  h3 {
    font-size: 1.5rem;
    margin-top: 2rem;
  }

  p {
    margin: 1rem 0;
  }

  ul, ol {
    margin: 1rem 0;
    padding-left: 2rem;
  }

  li {
    margin: 0.5rem 0;
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--color-secondary);
    text-decoration: underline;
  }

  code {
    background-color: var(--color-light-gray);
    color: #334155;
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-family: "Fira Code", "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.875em;
    border: 1px solid var(--color-border);
  }

  pre {
    background-color: var(--color-light-gray);
    padding: 1.25rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
  }

  pre code {
    background: transparent;
    padding: 0;
    border: none;
    font-size: 0.875rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }

  @media (max-width: 768px) {
    header .header-content {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    header .logo {
      height: 50px;
    }

    header h1 {
      font-size: 1.5rem;
    }

    header p {
      font-size: 1rem;
    }

    main {
      padding: 1.5rem 1rem;
    }

    h2 {
      font-size: 1.5rem;
    }

    h3 {
      font-size: 1.25rem;
    }
  }
</style>
